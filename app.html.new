function OfflineBanner(){
  const [offline,setOffline]=React.useState(!navigator.onLine);
  React.useEffect(()=>{
    const goOn=()=>setOffline(false);
    const goOff=()=>setOffline(true);
    window.addEventListener('online',goOn);
    window.addEventListener('offline',goOff);
    return()=>{window.removeEventListener('online',goOn);window.removeEventListener('offline',goOff);};
  },[]);
  if(!offline)return null;
  return React.createElement('div',{style:{
    position:'fixed',top:0,left:0,right:0,zIndex:9999,
    background:'#EF4444',color:'#fff',textAlign:'center',
    padding:'10px',fontSize:12,
    fontFamily:"'IBM Plex Mono',monospace",
    fontWeight:700,letterSpacing:'0.05em'
  }},'⚠️  You are offline — changes will not be saved until connection is restored');
}

/* ── helpers ── */
const today=()=>new Date().toISOString().split("T")[0];
const nowTs=()=>new Date().toISOString();
const uid=()=>`id_${Date.now()}_${Math.random().toString(36).slice(2,7)}`;
const daysLeft=d=>d?Math.ceil((new Date(d)-new Date())/(864e5)):null;
const fmtDate=d=>d?new Date(d).toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric"}):"";
const fmtTs=ts=>{if(!ts)return"";const d=new Date(ts);return d.toLocaleDateString("en-US",{month:"short",day:"numeric"})+' '+d.toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit"});};

/* ── Input Sanitization & Validation ── */
const SANITIZE_STRIP = /[<>\"\'%;()&+]/g;
const SANITIZE_ESCAPE = { '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;', ';': '&#59;', '--': '&#45;&#45;', '/*': '&#47;*', '*/': '*&#47;' };

function sanitizeInput(str, stripMode = false){
  if(!str || typeof str !== 'string') return '';
  let cleaned = str.trim();
  if(stripMode){
    cleaned = cleaned.replace(SANITIZE_STRIP, '');
  }else{
    Object.entries(SANITIZE_ESCAPE).forEach(([k,v]) => cleaned = cleaned.replaceAll(k, v));
  }
  return cleaned.slice(0, 10000);
}

function sanitizeName(str){ return sanitizeInput(str, true).slice(0, 200); }
function sanitizeDescription(str){ return sanitizeInput(str, false).slice(0, 5000); }
function sanitizeEmail(str){
  if(!str) return '';
  const email = str.trim().toLowerCase().slice(0, 254);
  return email.replace(/[<>\"\'%;()&+]/g, '');
}
function sanitizeUrl(str){
  if(!str) return '';
  let url = str.trim().slice(0, 2048);
  if(url && !url.match(/^https?:\/\//i)) url = 'https://' + url;
  return url.replace(/[<>"\'%;()&]/g, '');
}
function sanitizePhone(str){
  if(!str) return '';
  return str.replace(/[^+0-9]/g, '').slice(0, 20);
}
function sanitizeDate(str){
  if(!str) return '';
  return str.replace(/[^0-9\-]/g, '').slice(0, 10);
}

const VALIDATION_PATTERNS = {
  email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
  url: /^https?:\/\/[^\s<>"\'%;()&]+$/i,
  phone: /^\+?[0-9]{7,20}$/,
  date: /^\d{4}-\d{2}-\d{2}$/,
};

function validateField(type, value){
  if(!value || !value.trim()) return { valid: false, message: 'This field is required' };
  const v = value.trim();
  switch(type){
    case 'email':
      if(!VALIDATION_PATTERNS.email.test(v)) return { valid: false, message: 'Please enter a valid email address (e.g., you@company.com)' };
      break;
    case 'url':
      if(v && !VALIDATION_PATTERNS.url.test(v)) return { valid: false, message: 'Please enter a valid URL (e.g., https://example.com)' };
      break;
    case 'phone':
      if(v && !VALIDATION_PATTERNS.phone.test(v)) return { valid: false, message: 'Please enter a valid phone number' };
      break;
    case 'date':
      if(v && !VALIDATION_PATTERNS.date.test(v)) return { valid: false, message: 'Please enter a valid date (YYYY-MM-DD)' };
      break;
    case 'name':
      if(v.length < 2) return { valid: false, message: 'Name must be at least 2 characters' };
      if(v.length > 200) return { valid: false, message: 'Name must be less than 200 characters' };
      break;
    case 'description':
      if(v.length > 5000) return { valid: false, message: 'Description must be less than 5000 characters' };
      break;
  }
  return { valid: true, message: '' };
}

/* ── Friendly auth error messages ── */
function friendlyAuthError(err){
  if(!err)return null;
  const msg=(err.message||"").toLowerCase();
  if(msg.includes("invalid login credentials"))return"Incorrect email or password. Please try again.";
  if(msg.includes("email not confirmed"))return"Please confirm your email first. Check your inbox.";
  if(msg.includes("user already registered"))return"An account with this email already exists. Try signing in.";
  if(msg.includes("password should be"))return"Password must be at least 6 characters.";
  if(msg.includes("unable to validate"))return"Invalid email address format.";
  if(msg.includes("rate limit")||msg.includes("too many"))return"Too many attempts. Please wait a moment and try again.";
  if(msg.includes("network")||msg.includes("fetch"))return"Network error. Check your connection and try again.";
  return err.message||"Something went wrong. Please try again.";
}

function Spinner({dark}){
  return <span className={dark?"spinner spinner-dark":"spinner"}/>;
}

function getDrift(crs){
  if(!crs||!crs.length)return{pct:0,level:"No Drift",color:"#0EA5E9",grade:"A"};
  const pct=Math.round(((crs.filter(c=>c.status==="approved").length+crs.filter(c=>c.status==="pending").length*.5)/crs.length)*100);
  if(pct<20)return{pct,level:"Minimal",color:"#0EA5E9",grade:"A"};
  if(pct<40)return{pct,level:"Moderate",color:"#F59E0B",grade:"B"};
  if(pct<60)return{pct,level:"High",color:"#F97316",grade:"C"};
  return{pct,level:"Critical ⚠",color:"#EF4444",grade:"D"};
}

function getHealth(proj){
  const crs=proj.changeRequests||proj.change_requests||[];
  const d=getDrift(crs);
  const dl=daysLeft(proj.dueDate||proj.due_date);
  let score=100;
  score-=d.pct*0.4;
  const pending=crs.filter(c=>c.status==="pending").length;
  score-=pending*8;
  if(dl!==null){if(dl<0)score-=30;else if(dl<7)score-=15;else if(dl<14)score-=5;}
  score=Math.max(0,Math.min(100,Math.round(score)));
  const color=score>70?"#059669":score>40?"#D97706":"#DC2626";
  const label=score>70?"Healthy":score>40?"At Risk":"Critical";
  return{score,color,label};
}

